# Environment contract only. Never commit real credentials.
# Configure distinct values in Vercel Preview and Production.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database Connection (Drizzle Kit / Postgres)
DATABASE_URL=

# Gemini API Configuration for Stella AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stella Feature Flags (disabled by default)
STELLA_ENABLED=false
STELLA_ADVISOR_ENABLED=false
STELLA_VALIDATOR_ENABLED=false
STELLA_COMPOSER_ENABLED=false
# Fase 5b reviewer roles (read-only, requires_human_review always true).
# Enable ONE at a time, only after `eval:roles` is green — see docs/ops/gates/G4_PACKAGE.md.
# Revisor de Proxies: flags proxy source/reference-year/approval-status/confidence gaps
# Persistencia de decisiones sobre sugerencias de Stella.
# false por defecto. No activar antes de completar y verificar G2 y G3.
# La activación requiere un gate posterior y una decisión explícita.
# No contiene secretos; es únicamente un feature flag.
STELLA_DECISIONS_PERSISTENCE_ENABLED=false
STELLA_PROXY_REVIEWER_ENABLED=false
# Revisor de Evidencia: flags evidence integrity/confidence/linkage/coverage gaps
STELLA_EVIDENCE_REVIEWER_ENABLED=false
# Asistente de Auditoría: audit-readiness overview incl. human run-review trail
STELLA_AUDIT_ASSISTANT_ENABLED=false
STELLA_RATE_LIMIT_PER_HOUR=100

# Vercel Deployment & Environment Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (invitation/transactional emails)
RESEND_API_KEY=
EMAIL_FROM=Uellix <noreply@uellix.com>
RESEND_FROM_EMAIL=Uellix <noreply@uellix.com>

# Stripe (Monetization & Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# CAP-03 — conexión exclusiva del handler del webhook de Stripe.
# Debe declarar el rol uellix_stripe. NO se comparte con ningún otro servicio.
# Sin aprovisionar: el handler devuelve 503 y no intenta nada.
# Ver docs/ops/capabilities/CAP_03_STRIPE.md §13.
UELLIX_STRIPE_DATABASE_URL=

# Upstash Redis (Rate Limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Sentry (Error Monitoring & Performance)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
