        }
      }
    },
    "section_post_mr3": {
      "type": "object",
      "required": [
        "n21_three_boolean_assertion",
        "n22_full_poststate_table",
        "n22_read_only_proof"
      ],
      "additionalProperties": false,
      "properties": {
        "n21_three_boolean_assertion": {
          "description": "Conditional on N20 firing. NOT_APPLICABLE recorded explicitly, not omitted, when N15 decided SKIP.",
          "type": "object",
          "required": [
