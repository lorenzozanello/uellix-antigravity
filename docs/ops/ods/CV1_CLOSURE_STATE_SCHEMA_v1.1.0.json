    "binding_invalidator_kind": "BINDING_CHANGED",
    "ttl_freshness": "TTL",
    "repository_class": "REPOSITORY_FACT",
    "observation_class": "PROVIDER_OBSERVATION",
    "certification_class": "INDEPENDENT_CERTIFICATION",
    "human_decision_class": "HUMAN_DECISION",
    "inference_class": "INFERENCE",
    "authored_state": "AUTHORED",
    "certified_state": "CERTIFIED",
    "materialized_state": "MATERIALIZED",
    "execution_state": "ARMED",
    "executed_state": "EXECUTED",
    "evidenced_state": "EVIDENCED",
    "closed_state": "CLOSED"
  },
  "x-vocabulary-enums": {
    "pass_statuses": "certification_status",
    "status_for_outcome": "certification_status",
    "pass_outcomes": "certification_outcome",
    "uncertified_statuses": "certification_status",
    "unbound_certification_statuses": "certification_status",
    "implementation_satisfied": "implementation_status",
    "durable_classes": "evidence_class",
