    "integrated_status": "integration_status",
    "not_integrated_status": "integration_status",
    "not_implemented_status": "implementation_status",
    "integration_certification_scope": "certification_scope",
    "integrated_evidence_scope": "evidence_scope",
    "independent_kind": "certification_kind",
    "open_finding_status": "finding_status",
    "resolving_finding_statuses": "finding_status",
    "superseded_finding_status": "finding_status",
    "binding_invalidator_kind": "invalidator_kind",
    "ttl_freshness": "freshness_class",
    "repository_class": "evidence_class",
    "observation_class": "evidence_class",
    "certification_class": "evidence_class",
    "human_decision_class": "evidence_class",
    "inference_class": "evidence_class",
    "authored_state": "lifecycle_state",
    "certified_state": "lifecycle_state",
    "materialized_state": "lifecycle_state",
    "execution_state": "lifecycle_state",
    "executed_state": "lifecycle_state",
    "evidenced_state": "lifecycle_state",
    "closed_state": "lifecycle_state"
  },
  "x-transition-graph": {
    "initial_states": ["UNDESIGNED", "AUTHORED"],
    "forward": {
      "UNDESIGNED": { "to": "AUTHORED", "basis_classes": ["REPOSITORY_FACT"], "basis_ref": "entry.candidate_sha" },
      "AUTHORED": { "to": "CERTIFIED", "basis_classes": ["INDEPENDENT_CERTIFICATION"], "basis_ref": "certification" },
      "CERTIFIED": { "to": "MATERIALIZED", "basis_classes": ["REPOSITORY_FACT"], "basis_ref": "lineage_shas.materialization" },
      "MATERIALIZED": { "to": "ARMED", "basis_classes": ["REPOSITORY_FACT", "HUMAN_DECISION"], "basis_ref": null, "requires_dependencies": true, "requires_no_open_findings": true },
      "ARMED": { "to": "EXECUTED", "basis_classes": ["REPOSITORY_FACT"], "basis_ref": null },
      "EXECUTED": { "to": "EVIDENCED", "basis_classes": ["REPOSITORY_FACT"], "basis_ref": "lineage_shas.evidence_head" },
      "EVIDENCED": { "to": "CLOSED", "basis_classes": ["HUMAN_DECISION"], "basis_ref": null, "requires_dependencies": true, "requires_no_open_findings": true }
    },
    "authored_basis_classes": ["REPOSITORY_FACT"],
    "rebind_states": ["AUTHORED", "CERTIFIED"],
    "genesis_forbidden_final_states": ["ARMED", "CLOSED"],
    "new_record_max_final_state": "AUTHORED",
    "dependency_max_applies_from_state": "ARMED"
  },
