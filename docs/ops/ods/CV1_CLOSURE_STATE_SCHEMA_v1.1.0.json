        "covered_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "covered_package_digest": { "$ref": "#/$defs/sha256_or_null" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_item" } },
        "evidence_freshness": { "$ref": "#/$defs/freshness_class" },
        "evidence_expires_at": { "$ref": "#/$defs/datetime_or_null" },
        "observed_at": { "$ref": "#/$defs/datetime_or_null" },
        "invalidated_by": { "type": "array", "items": { "$ref": "#/$defs/invalidator" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "blocking_findings": { "type": "array", "items": { "$ref": "#/$defs/blocking_finding" } },
        "branch": { "type": ["string", "null"] },
        "pr": { "type": ["integer", "null"], "minimum": 1 },
        "execution_allowed": { "type": "boolean" },
        "risk_tier": { "$ref": "#/$defs/risk_tier" },
        "next_legal_act": { "type": "string", "minLength": 1 },
        "unconfirmed": { "type": "array", "items": { "$ref": "#/$defs/unconfirmed_fact" } },
        "notes": { "type": "string" }
      }
    }
  }
}
