{
  "name": "uellix",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rls": "vitest run --config vitest.integration.config.ts tests/integration/rls.test.ts",
    "db:test:integration:local": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/blocked-command.ts db:migrate db:migrate:local",
    "db:migrate:local": "tsx scripts/db-migrate-local.ts drizzle",
    "db:prepared:apply:local": "tsx scripts/db-migrate-local.ts prepared",
    "db:prepared:verify:local": "tsx scripts/db-migrate-local.ts verify",
    "db:rotate:local-credentials": "tsx scripts/rotate-local-role-credentials.ts",
    "db:setup:local": "pnpm db:migrate:local && pnpm db:seed:local",
    "db:guard:local-reset": "tsx scripts/guard-local-reset.ts",
    "db:reset:local": "pnpm db:guard:local-reset && pnpm supabase stop --no-backup && pnpm supabase start && pnpm db:setup:local",
    "db:audit:readonly": "tsx scripts/db-audit-readonly.ts",
    "db:seed:local": "tsx scripts/seed-local.ts",
    "db:seed:stella-local": "tsx scripts/seed-stella-local.ts",
    "db:seed:local:proxies": "tsx scripts/seed-proxies.ts",
    "db:seed:local:taxonomies": "tsx scripts/seed-taxonomies.ts",
    "db:seed:proxies": "tsx scripts/blocked-command.ts db:seed:proxies db:seed:local:proxies",
    "db:seed:taxonomies": "tsx scripts/blocked-command.ts db:seed:taxonomies db:seed:local:taxonomies",
    "eval:offline": "tsx scripts/eval-offline.ts",
    "eval:roles": "tsx scripts/eval-roles-offline.ts",
    "test:stella:release-eval": "tsx scripts/eval-release-offline.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.10.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.66.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "shadcn": "^4.11.0",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": "0.25.0",
      "postcss@<8.5.10": "8.5.10",
      "brace-expansion@<1.1.16": "1.1.16",
      "brace-expansion@>=3.0.0 <5.0.7": "5.0.7",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "protobufjs@>=7.5.0 <=7.6.4": "7.6.5",
      "fast-uri@>=3.0.0 <3.1.4": "3.1.4",
      "sharp@<0.35.0": "0.35.3",
      "@google/genai>@modelcontextprotocol/sdk": "-"
    }
  }
}
